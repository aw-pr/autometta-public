.DS_Store
.publish-guard.local
*.local
.autometta.local.yaml
.autometta/
symlinked-config/
*.swp
.idea/
.vscode/
__pycache__/
*.pyc
.venv/
.env
.env.*
!.env.example
op-refs.local.sh
.claude/
logs/
runs/*.log

state/logs/
state/**
!state/handoffs/
!state/handoffs/.gitkeep
!state/handoffs/README.md

/VERSION

# Dashboard: Chart.js is downloaded at install time, not committed.
dashboard/vendor/
# HANDOFF.md is tracked, not ignored. It is the SESSION handoff -- prose for
# the next chat -- and tracking is what makes it follow a clone or worktree.
# Privacy is enforced at the publish boundary instead: publishguard.privatefile
# names it, so the pre-push guard blocks it fail-closed from the public head.
# Not to be confused with state/handoffs/<stage>.json, which is the worker's
# completion signal to tick.sh -- a different mechanism sharing a word.
.codegraph/
.publish-guard-strict.local
.claude/settings.local.json

# Local-by-design files (audit report states "Not committed by design"; .mcp.json is machine-local MCP config)
FABLE-SECURITY-AUDIT.md
.mcp.json
examples/bake-off/batch.log
