# Copy to .autometta.local.yaml (gitignored under *.local) and fill in
# the per-repo manifest. This file is the documented template; the real
# file stays out of the tree.

version: 1

# Optional override of where the autometta repo lives. Defaults to the
# value detected by subscribe-repo.sh at registration time.
# autometta_root: /Users/yourname/repos/autometta

state_dir: state

stage_card_globs:
  - stage-cards/*.md

templates_mode: upstream

# ---------------------------------------------------------------------------
# Auth routes (per family). Recommended defaults below: codex on `api`
# (avoids ChatGPT-mode billing surprises and the sibling-CODEX_HOME setup
# is a one-off), claude on `subscription` (Claude Pro session). Flip
# either to suit the repo. The resolver fallback if this file is absent
# is `subscription` for both.
#
# This file only controls WHICH route. The op:// references themselves live
# in op-refs.sh (committed placeholders) + op-refs.local.sh (gitignored
# real refs). See the auth-route-security skill for the full pattern.
#
# Override at dispatch time without editing this file:
#   AUTOMETTA_CODEX_MODE=api  autometta tick
#   AUTOMETTA_CLAUDE_MODE=api autometta tick
#
# The dispatch path is always op-fetch -> child (env -i + allowlist), so
# subscription mode also gets a sanitised env that strips any inherited
# OPENAI_API_KEY / ANTHROPIC_API_KEY from the parent shell. api mode fails
# closed if op-fetch is missing or the matching OP_REF_* points at the
# YOUR_VAULT placeholder.
# ---------------------------------------------------------------------------

auth:
  codex:
    mode: api    # recommended default; requires OP_REF_OPENAI_API_KEY in op-refs.local.sh
    # mode: subscription   # ChatGPT OAuth via ~/.codex/auth.json
    # mode: local   # codex-family only; `codex exec --oss` against local Ollama
    #               # weights, zero marginal cost, no rate limits. Needs a
    #               # one-time `ollama pull gpt-oss:120b` (see docs/setup.md
    #               # section 7). Best for stages with mechanical acceptance
    #               # (smoke scripts, bash -n, fixture comparisons); keep a
    #               # frontier verifier for judgement-heavy criteria.
  claude:
    mode: subscription   # recommended default; uses Claude Pro session
    # mode: api    # requires OP_REF_ANTHROPIC_API_KEY in op-refs.local.sh
    # mode: local is refused for claude, since a Claude-family local route
    # would be a different CLI and a different card.

# ---------------------------------------------------------------------------
# Verifier transport overrides. Optional, and usually unnecessary: leave the
# key unset and each verifier family reaches for its SDK entrypoint first.
# Both SDK routes support api and subscription auth, so there is no auth mode
# on which the default is unreachable.
#
# An unset key resolves in this order:
#   sdk   (provenance default-sdk)   the SDK preconditions are all present
#   cli   (provenance fallback-cli)  one is missing, and the log names it
#
# The preconditions are the SDK entrypoint script, its python packages, and
# the auth mode's credential. A missing one is never an error: the dispatch
# keeps working on the CLI. `auth.codex.mode: local` has no SDK entrypoint
# and always falls back this way.
#
# Set `cli` to hold a family on the old route. That is an explicit pin, not a
# fallback, and it is honoured exactly as written.
#
# IMPORTANT: the Codex SDK reuses CODEX_HOME authentication. On subscription,
# it must use ~/.codex with auth_mode: chatgpt; on api, it must use the
# api-only sibling with auth_mode: apikey. The spawner checks this before it
# launches, so a billing-route mismatch fails closed.
#
# Before relying on the SDK default, install the packages once:
#   pip install -r scripts/requirements-sdk.txt
#
# To see which route a family would take here, without spending a token:
#   scripts/spawn-verifier.sh --print-transport claude <repo>
#   scripts/spawn-verifier.sh --print-transport codex <repo>
#
# To A/B compare routes without editing this file:
#   AUTOMETTA_CLAUDE_TRANSPORT=cli scripts/spawn-verifier.sh <card> <repo>
#   AUTOMETTA_CODEX_TRANSPORT=sdk AUTOMETTA_CODEX_MODE=subscription scripts/spawn-verifier.sh <card> <repo>
#
# Codex workers are not affected; they always use `codex exec`.
# ---------------------------------------------------------------------------

# verifier:
#   claude:
#     transport: cli   # pin the old route; uses `claude -p` (subscription or api)
#     # transport: sdk   # scripts/verify-sdk.py, named explicitly. Same route
#     #   the unset key takes, but an explicit sdk fails closed on a missing
#     #   precondition instead of falling back to cli.
#
#     # Optional Fable-as-advisor verifier. The request model (transport: sdk,
#     # e.g. claude-sonnet-4-6) does the bulk reading; the advisor is consulted
#     # only at the decision point. The advisor must NOT be weaker than the
#     # request model — verify-sdk.py rejects an inverted pair locally (#66714).
#     # sdk + auth.claude.mode: api only; default off. DATA RETENTION: the
#     # advisor receives the stage card and artefacts (org-wide 30-day
#     # retention); do NOT point it at a repo whose artefacts carry personal data.
#     # advisor: claude-fable-5
#     # Override without editing this file:
#     #   AUTOMETTA_CLAUDE_ADVISOR=claude-fable-5 scripts/spawn-verifier.sh <card> <repo>
#   codex:
#     transport: cli   # pin the old route; uses `codex exec` (subscription or api)
#     # transport: sdk   # scripts/verify-sdk-openai.py, named explicitly, with
#     #   the same fail-closed behaviour as the claude key above.
#
# ---------------------------------------------------------------------------
# Orchestrator transport design only. These keys are not active and do not
# change dispatch. A production SDK orchestrator is gated behind the card-23
# experiment verdict; see docs/design/orchestrator-sdk-transport.md.
# ---------------------------------------------------------------------------
# orchestrator:
#   claude:
#     # transport: cli | sdk   # design-pending card 23
#   codex:
#     # transport: cli | sdk   # design-pending card 23

# ---------------------------------------------------------------------------
# Pipeline pairing. Optional. Two adjacent stages with disjoint path_claims may
# run their workers at once; this key decides what counts as "two independent
# workers".
#
#   family  (default)  the vendor family, as it has always been: two codex
#                      workers refuse to pair, codex + claude may.
#   target             family plus the weights, for an identity naming a local
#                      Ollama model. Needed on auth.codex.mode: local, where
#                      every dispatch is family codex and a fully free run
#                      could otherwise never pair at all.
#
# Cloud identities are unaffected by `target`: two Codex API workers share one
# provider rate-limit window whichever model they name, and that window is what
# the gate protects. An invalid value falls back to `family`.
#
# Override without editing this file:
#   AUTOMETTA_PIPELINE_PAIR_ON=target autometta tick
# ---------------------------------------------------------------------------

# pipeline:
#   pair_on: family   # default; or `target` on the local route

# ---------------------------------------------------------------------------
# Local Ollama model per role, for auth.codex.mode: local. Optional.
#
# Most repos need neither key: a stage card's declared Worker / Verifier
# identity already names its weights (e.g. `Codex Llama 3.3 70B`), and that
# wins over anything set here. These are the fallback for a card whose identity
# names no local model, and they are what stops the worker and the verifier
# being the same weights, which is the worker marking its own homework.
# ---------------------------------------------------------------------------

# codex:
#   local_model:
#     worker: llama3.3:70b
#     verifier: gpt-oss:20b
