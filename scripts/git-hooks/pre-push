#!/usr/bin/env bash
# Publish guard — pre-push. Fail-closed gate for a public mirror.
#
# CANONICAL SOURCE: mcp-hub/templates/git-hooks/pre-push.
# Do NOT edit the per-repo copy under scripts/git-hooks/ — edit this template
# and re-sync (mcp-hub/scripts/sync-all-platforms.sh), then re-arm each repo
# with scripts/install-guards.sh.
#
# Per-repo config (git config, local, never committed — keeps org/repo names
# out of the tracked tree):
#   publishguard.publicmatch   Substring of the PUBLIC remote URL (e.g.
#                              "myorg/myrepo"). Unset -> this hook is inert.
#   publishguard.sentinel      Env var the sanctioned publish path sets to 1.
#                              Default: PUBLISH_GUARD_OK
#   publishguard.historymode   preserve (default) | squash. Informational here;
#                              affects merge style upstream, surfaced in errors.
#   publishguard.privatefile   (repeatable) path that must NEVER reach the
#                              public tree. Default: HANDOFF.md
#   publishguard.publishbranch Local branch that ff's onto public default.
#                              Default: publish. Used here only as the default
#                              source for publishguard.prsource below.
#   publishguard.prsource      Branch allowed on the PUBLIC remote as a PR
#                              source (publish → main PR-for-publish flow).
#                              Default: value of publishguard.publishbranch.
#   publishguard.boundary      pr (default) | direct. In pr mode the push to
#                              the public default branch additionally requires
#                              PUBLISH_PR_REVIEWED=1 in the environment — the
#                              attestation that a publish→main PR was opened
#                              and its diff reviewed. The ff push then
#                              completes the PR (GitHub marks it merged when
#                              base receives the head SHAs). direct mode keeps
#                              the sentinel-only gate for repos that opt out.
#
# On the public remote: only the default branch (main/master) may be pushed,
# AND that push must arrive via the sanctioned path (sentinel env set) — i.e.
# `git publish`, which backs up to the private remote first. A direct
# `git push <public> dev:main` is blocked so it cannot skip that backup.
# Non-fast-forward pushes to the public default branch are rejected even with
# the sentinel set ("PUB/main is immutable"). A push whose tree still contains
# a private file is rejected.
#
# The PR-source branch (publishguard.prsource) is also allowed on the public
# remote — this is the "publish-pr" fast-forward-free path: push `publish` as
# a non-default branch, then open a PR publish→main and review the diff before
# merging on GitHub. It does NOT require the sentinel (it isn't the sanctioned
# main-publish path — the PR review is the safeguard there) and is not subject
# to the ff-only check (it's an ordinary branch, not the immutable public
# default). It STILL runs the private-file tree scan: a privatefile leak on
# the PR source must be rejected exactly like on main, fail-closed. Any other
# non-default ref is still rejected.
# Optional chain point: scripts/publish-guard-strict-scan.sh (runs if present).
# Deliberate one-off override: git push --no-verify
remote_name="$1"
remote_url="$2"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# Strict scanner — runs on every push, regardless of remote, if the repo ships
# one. Catches personal positioning phrases before any push leaves the laptop.
if [ -n "$repo_root" ] && [ -x "$repo_root/scripts/publish-guard-strict-scan.sh" ]; then
  "$repo_root/scripts/publish-guard-strict-scan.sh"
fi

pub_match="$(git config --get publishguard.publicmatch || true)"
[ -z "$pub_match" ] && exit 0                 # not configured -> nothing to guard
case "$remote_url" in
  *"$pub_match"*) : ;;                         # public — restricted below
  *) exit 0 ;;                                 # private/backup — allow everything
esac

sentinel="$(git config --get publishguard.sentinel || true)"
[ -z "$sentinel" ] && sentinel="PUBLISH_GUARD_OK"
history_mode="$(git config --get publishguard.historymode || true)"
[ -z "$history_mode" ] && history_mode="preserve"

# Private files that must never reach the public tree (repeatable git config).
private_files="$(git config --get-all publishguard.privatefile || true)"
[ -z "$private_files" ] && private_files="HANDOFF.md"

# PR-source branch for the publish-pr flow. Defaults to publishbranch (empty
# publishbranch -> empty pr_source -> the case pattern below matches nothing,
# so the PR path stays disabled rather than silently matching an odd ref).
pr_source="$(git config --get publishguard.prsource || true)"
if [ -z "$pr_source" ]; then
  pr_source="$(git config --get publishguard.publishbranch || true)"
fi

# Zero SHA = ref deletion or initial push. Bash 3.2-compatible (no associative).
zero="0000000000000000000000000000000000000000"

# Reject the push if the tree being pushed contains a private file. Shared by
# both the main-publish path and the PR-source path — fail-closed on both.
check_privatefile() {
  sha="$1"
  ref="$2"
  [ "$sha" = "$zero" ] && return 0
  pub_tree="$(git ls-tree -r --name-only "$sha" 2>/dev/null || true)"
  while IFS= read -r pf; do
    [ -z "$pf" ] && continue
    if printf '%s\n' "$pub_tree" | grep -qx "$pf"; then
      echo "pre-push: private file '$pf' present in the tree pushed to" >&2
      echo "          PUBLIC '$ref' — blocked. It is dev-only; keep it" >&2
      echo "          out of the publish tree. Deliberate override: --no-verify." >&2
      return 1
    fi
  done <<< "$private_files"
  return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "")
      : ;;
    refs/heads/main|refs/heads/master)
      if [ "${!sentinel:-}" != "1" ]; then
        echo "pre-push: direct publish to PUBLIC remote '$remote_name' blocked." >&2
        echo "          Run 'git publish' — it backs up to the private remote" >&2
        echo "          first, then publishes. Deliberate override: --no-verify." >&2
        exit 1
      fi
      # PR-for-publish boundary (default). The sentinel proves the push came
      # via the sanctioned alias; this proves a human-reviewable PR diff was
      # put between the curated head and the public default branch.
      boundary="$(git config --get publishguard.boundary || true)"
      [ -z "$boundary" ] && boundary="pr"
      if [ "$boundary" = "pr" ] && [ "${PUBLISH_PR_REVIEWED:-}" != "1" ]; then
        echo "pre-push: publish boundary is PR-by-default — push to PUBLIC" >&2
        echo "          '$remote_ref' needs a reviewed publish PR first:" >&2
        echo "            1. git push $remote_name ${pr_source:-publish}   (PR source, scanned)" >&2
        echo "            2. gh pr create --base main --head ${pr_source:-publish}  (review the diff)" >&2
        echo "            3. re-run with PUBLISH_PR_REVIEWED=1 — the ff push" >&2
        echo "               completes the PR (GitHub marks it merged)." >&2
        echo "          Repo-level opt-out: git config publishguard.boundary direct" >&2
        exit 1
      fi
      # Block non-fast-forward to public default branch even with the sentinel.
      # Enforces "PUB/main is immutable" (critical in historymode=preserve;
      # always-true in squash where publish is append-only anyway).
      if [ "$remote_sha" != "$zero" ] && [ "$local_sha" != "$zero" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
          echo "pre-push: non-fast-forward push to PUBLIC '$remote_ref' blocked." >&2
          echo "          history mode = ${history_mode}. PUB/main is immutable —" >&2
          echo "          published commits must not be rewritten. If this is a" >&2
          echo "          deliberate incident-grade history rewrite, override with" >&2
          echo "          --no-verify and confirm with the user first." >&2
          exit 1
        fi
      fi
      # Private files must not exist in the tree being published.
      check_privatefile "$local_sha" "$remote_ref" || exit 1
      ;;
    refs/heads/"$pr_source")
      # PR-for-publish source path: `publish` (or configured prsource) pushed
      # as a non-default branch, then `gh pr create publish->main` for review.
      # No sentinel required — this isn't the sanctioned main-publish path,
      # the PR review is the safeguard here. No ff-only check — this is an
      # ordinary branch, not the immutable public default. The private-file
      # scan still runs, fail-closed, same as the main-publish path.
      check_privatefile "$local_sha" "$remote_ref" || exit 1
      ;;
    *)
      echo "pre-push: '$remote_ref' blocked on PUBLIC remote '$remote_name'." >&2
      echo "          Only the default branch is public. Override: --no-verify." >&2
      exit 1 ;;
  esac
done
exit 0
