flowchart LR
  S[("git — state + budget")]
  S -->|"tick · cron / launchd / human"| C["stage card<br/>= worker prompt"]
  C --> W["worker · family A<br/>sandboxed"]
  W --> AC{"acceptance command"}
  AC -- pass --> V["verifier · family B<br/>outside the sandbox"]
  AC -- fail --> BUD{"budget left?"}
  V -- accept --> G["commit on green<br/>→ next stage"]
  V -- reject --> BUD
  BUD -- yes --> C
  BUD -- no --> H["halt + escalate"]
  G --> S
